// aprendendo a usar while //


print("=== Soma até digitar 0 ===")

soma = 0
quantidade = 0


while True:
    numero = int(input("Digite um número: "))
    if numero == 0:
        break
    
    soma += numero
    quantidade += 1
    
    
print("\nresultado final: ")
print("soma:", soma)
print("quantidade de numeros:", quantidade)


if quantidade > 0:
    media = soma/quantidade
    print("media: ", media)
else:
    print("inválido")

